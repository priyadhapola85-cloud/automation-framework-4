# Copy to .env and adjust. Never commit real credentials (.env is git-ignored).

# Base URL of the API under test (no trailing slash)
API_BASE_URL=http://15.252.197.75:8000

# Dashboard bind address (keep 127.0.0.1 so the dashboard is not exposed on the network)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4310

# Shared limit for ALL outbound operations (API requests + DB queries). Hard ceiling: 2.
RATE_LIMIT_PER_SEC=2

# Retries after the initial attempt (hard ceiling 3 => max 4 attempts)
MAX_RETRIES=3
RETRY_BACKOFF_MS=1000

# Per-request timeout and worker count (1-4; the rate limit still applies)
REQUEST_TIMEOUT_MS=15000
EXECUTION_CONCURRENCY=2

# ---- Database (MariaDB/MySQL, read-only) -------------------------------------
# Option A: point to an existing, already-configured file (only DB_* / SSH_* keys are read):
# DB_ENV_FILE=C:\path\to\existing\.env
#
# Option B: set the keys here.
# DB_HOST=15.252.197.75
# DB_PORT=3306
# DB_NAME=streamer_api
# DB_USER=
# DB_PASSWORD=
# DB_SSH_ENABLED=true          # MariaDB 3306 is only reachable through SSH
# SSH_HOST=15.252.197.75
# SSH_PORT=22
# SSH_USER=
# SSH_PASSWORD=                # or SSH_PRIVATE_KEY_PATH=
# DB_HOST_VIA_SSH=127.0.0.1    # database address as seen from the SSH server
